import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt
border="-"*50
def main():
    X=[1,2,3,4,5]
    Y=[3,4,2,4,5]
    #X_mean=np.mean(X)
    #Y_mean=np.mean(Y)
    sum_x=0
    sum_y=0
    for i in X:
        sum_x=sum_x+i
    Mean_X=sum_x/len(X)   
    for i in Y:
        sum_y=sum_y+i
        
    Mean_Y=sum_y/len(Y) 
    print(border)  
    print("Mean of X:",Mean_X)
    print("Mean of Y:",Mean_Y)
    
    n=len(X)
    # Calculate the slope y=mx+c
    num=0
    den=0 
    for i in range(n):
        num=num+(X[i]-Mean_X)*(Y[i]-Mean_Y)
        den=den+(X[i]-Mean_X)**2
    m=num/den
    print("Slope of line:",m)
    
    #Intercept of Line y-mx=c
    c=Mean_Y-m*Mean_X
    print("Intercept is:",c)
    # Regression Equation
    print("y=0.4x+2.4")
    #--------------------------------------------------------------------   
    #Q2 - Using same Dataset calculate the model performance
    # Task 1- Predict all Y values  using regression equation , Mean Sqaure Error(MSE),R2 score 
    #--------------------------------------------------------------------
   
    y_list=[]
    for i in range(n):
        y_list.append(m*X[i]+c)
    print("Actual Y values:",Y)
    print(y_list)
    print(border)
    #Mean square error
    print("Mean Square Error")
    
    mse= sum((Y[i]-y_list[i])**2 for i in range(n))/n
    print("Mean Square Error:",mse)
    
    print("R2 sqaure Calculations:")
    
    a=sum((Y[i]-y_list[i])**2 for i in range(n))
    b=sum((Y[i]-Mean_Y)**2 for i in range(n)) 
    r2=a/b
    print("R2 square is:",r2)       
    
    #--------------------------------------------------------------------
    #Q3- Train Liner Regression Model
    #--------------------------------------------------------------------
    Data={
        "Experience":[1,2,3,4,5],
        "Salary":[20000,25000,30000,35000,40000]
    }
    df=pd.DataFrame(Data)
    print(border)
    print(df)
    print(border)
    X=df[["Experience"]]
    Y=df["Salary"]
    model=LinearRegression()
    model.fit(X,Y)
    print("Model trained")
    X_test=pd.DataFrame(
    [6],columns=["Experience"])
    Y_pred=model.predict(X_test)  
    print("Predicted salary for 6 years of experience:",Y_pred) 
      
    #--------------------------------------------------------------------
    # Q4 - Plot the regression line using matplotlib    
    #--------------------------------------------------------------------
    x=np.linspace(1,6,n)
    plt.plot(x,y_list,color="g",label="Regression Line")
    #plt.scatter(X,Y,color="r",label="Scatter Plot")
    plt.xlabel("X:Independent Variable")
    plt.ylabel("Y:Dependent Variable")
    plt.legend()
    plt.show()
