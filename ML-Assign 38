#-------------------------------------------------------------
#6. Plot a histogram of StudyHours.
#Explain what the distribution tells you
#-------------------------------------------------------------

plt.hist(df["StudyHours"],bins=10,color="green",edgecolor="black")
plt.title("Student Performance")
plt.xlabel("StudyHours")
plt.ylabel("Number of students")
plt.show()

#---------------------------------------------------------------
#Step 7. Create a scatter plot of:
#StudyHours vs PreviousScore
#--------------------------------------------------------------
print("Step 7 - Create a scatter plot of:")

plt.figure(figsize=(7,5))

for sp in df["FinalResult"].unique():
    temp=df[df["FinalResult"]==sp]
    plt.scatter(temp["StudyHours"],temp["PreviousScore"],label=sp)
plt.title("Student Study Hours vs PreviousScore")
plt.legend()
plt.xlabel("StudyHours")
plt.ylabel("PreviousScore")
plt.show()

#-------------------------------------------------------------------
#Step 8 - Boxplot for Attendance
#-------------------------------------------------------------------
print(Border)
print("Step 8 - Boxplot for Attendance")
print(Border)

plt.boxplot([df["Attendance"],df["StudyHours"]],patch_artist=True)
plt.title("Boxplot Attendance")
plt.xlabel("StudyHours")
plt.ylabel("Attedance $")
plt.show()


