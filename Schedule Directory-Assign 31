#5- Write a program that accepts a directory name from the user and counts the number of files inside it every five minutes.
Write the result into:
DirectoryCountLog.txt
Each entry should contain:
Directory path
Number of files
Date and time

import schedule
import datetime
import time
import os

def Dircnt(dir):
    fname=open("DirectoryCountLog.txt","a")
    
    for Foldername,subfolder,filename in os.walk(dir):
        fname.write("Directory path:"+Foldername+"\n")
        fname.write("Number of files:"+str(len(filename))+"\n")
        fname.write("Date and Time:"+datetime.datetime.now().strftime("%d-%m-%Y %H:%M:%S"+"\n\n\n"))
    fname.close()  
    print("Completed")
def main():
    dir=input("Enter the directory name:")
    if os.path.isdir(dir)==True:
        print("It is directory")
        schedule.every(14).seconds.do(Dircnt,dir)
        while(True):
            schedule.run_pending()
            time.sleep(10)
    else:
        print("Its not a directory")
    
if __name__=="__main__":
    main()
