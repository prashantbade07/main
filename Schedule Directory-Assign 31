4: Write a program that creates a new log file after every ten minutes.
The filename should contain the current date and time.
Example:
MarvellousLog_25_07_2026_16_30_00.txt
The file should contain:
Log file created successfully.
Creation Time: 25-07-2026 04:30:00 PM

import schedule
import time
import os
import datetime

def file():
    fname="MarvellousLog"+"_"+datetime.datetime.now().strftime("%d_%m_%Y_%H_%M_%S")+".txt"
    data=open(fname,"w")
    data.write("Log File created successfully"+"\n")
    t=datetime.datetime.now().strftime("%d-%m-%Y %I:%M:%S %p")
    data.write("Creation Time:"+ t+"\n")
    data.close()
def main():
    schedule.every(10).minutes.do(file)
    while(True):
        schedule.run_pending()
        time.sleep(8*60)
if __name__=="__main__":
    main()
