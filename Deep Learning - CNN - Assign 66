###################################################################################################
1: Write a Python program to simulate a single artificial neuron.
###################################################################################################
Input:  
x1 = 2
x2 = 3
w1 = 0.4
w2 = 0.6
bias = 0.5

Tasks:
Calculate weighted sum.
Apply sigmoid activation function.
Display final output.
Explain whether output is close to 0 or 1.

# Weighted Sum
y=(x1 * w1) +(x2 * w2) + bias
print("Weighted sum : ",round(y,4))

# Sigmoid activation function
act=1/(1+math.exp(-y))
print("Final sigmoid activation output :",round(act,4))

# Interpretation 
if act>0.5:
    print("Output closer to 1")
else :
    print("Output closer to 0")

###################################################################################################
2: Write a Python program to demonstrate different activation functions.
###################################################################################################

Functions to implement:
Sigmoid
ReLU
Tanh

Tasks:
Accept input values from −10 to 10.
Plot all activation functions using Matplotlib.
Explain the use of each activation function.

###############################################################
import numpy as np 
import matplotlib.pyplot as plt
# Input values from -10 to 10 
x=np.linspace(-10,10,200)

# Sigmoid
sigmoid=1/(1+np.exp(-x))

# ReLU
relu=np.maximum(0,x) 

# Tanh
tanh=np.tanh(x)

plt.figure(figsize=(10,6))
plt.plot(x,sigmoid,label='Sigmoid')
plt.plot(x,relu,label='ReLU')
plt.plot(x,tanh,label='Tanh')
plt.legend()
plt.title("Activation Function")
plt.xlabel("Input")
plt.ylabel("Output")
plt.grid(True)
plt.show()

# Use and Limitation of Each Activation Function
print("Sigmoid Use range(0,1) - Converts values into probabilites, commonly used in binary claasification output layers.")
print("Sigmoid Limitation - Can cause vanishing gradients in deep networks")

print("ReLU Use range[0,infinity) - Default choice for hidden layers in deep networks.Efficient, avoids vanishing gradient")
print("ReLU Limitation - Dying problem neuron stuck at 0")

print("Tanh range(-1,1) - Preferred in hidden layers when zero centered output are benefical.")
print("Tanh Limitation - Still suffer from vanishing gradient but less than sigmoid")


###################################################################################################
3: Write a Python program to calculate loss manually.
###################################################################################################

Tasks:
Implement Mean Squared Error.
Implement Binary Cross Entropy.
Take actual and predicted values.
Display the calculated loss.
Explain which loss function is used for regression and classification.


import numpy as np 

# Values 
y_true=np.array([1,0,1,1])
y_pred=np.array([0.9,0.2,0.8,0.4])

# Mean Squared Error (Regression)
mse=np.mean((y_true-y_pred)**2) 

#Binary Cross Entropy (Classification)
epsilon=1e-15
y_pred=np.clip(y_pred,epsilon,1-epsilon)
bce=-np.mean(y_true*np.log(y_pred)+(1-y_true)*np.log(1-y_pred))
print("Binary Cross Entropy :",bce)

print("MSE --> Regression tasks")
print("BCE --> Classification tasks")

###################################################################################################
4: Write a Python program to show how weights are updated in ANN.
###################################################################################################

Tasks:
Take input, weight, bias, target output, and learning rate.
Calculate prediction.
Calculate error.
Update weight using gradient descent logic.
Display old weight and updated weight

import math
# Inputs
x = 2
w = 0.5
bias = 0.1
target = 1
lr = 0.01  # learning rate

# Prediction using sigmoid 
z=w*x+bias 
y_pred=1/(1+math.exp(-z))

# Error 
error=target-y_pred

# Gradient descent update 
w_new= w+lr*error*x 
print("Old weight :",w)
print("New weight :",round(w_new,4))
