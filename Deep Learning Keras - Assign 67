##########################################################
import numpy as np 

from sklearn.preprocessing import StandardScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

# Load or create dataset.
# Clean the dataset.
# Apply StandardScaler.
# Train FNN model.
# Evaluate model.
# Predict for new customer.
##########################################################
# Step 1 - Load Dataset
##########################################################
print("-"*50)
print("Step 1 - Load Dataset")
print("-"*50)

X = np.array([
[25, 500, 12, 1, 2],
[30, 700, 24, 0, 1],
[45, 1200, 6, 5, 8],
[50, 1500, 5, 6, 10],
[28, 600, 18, 1, 1],
[35, 800, 30, 0, 0],
[48, 1400, 4, 7, 9],
[52, 1600, 3, 8, 12],
[27, 550, 20, 0, 1],
[42, 1300, 8, 4, 7]
])

Y=np.array([0,0,1,1,0,0,1,1,0,1])  # 0=stay , 1=leave
print("")

##########################################################
# Step 2 - Feature Scaling
##########################################################
print("-"*50)
print("Step 2 - Feature Scaling")
print("-"*50)

scalar=StandardScaler()

X_scaled=scalar.fit_transform(X)
print("")

print(X_scaled.shape)

##########################################################
# Step 3 - Build FNN model
##########################################################
print("-"*50)
print("Step 3 - Build FNN model")
print("-"*50)

model=Sequential([
    Dense(8,activation='relu',input_shape=(X_scaled.shape[1],)),
    Dense(4,activation='relu'),
    Dense(1,activation='sigmoid')
])
model.compile(optimizer='adam',loss='binary_crossentropy',metrics=['accuracy'])


##########################################################
# Step 4 - Train the model
##########################################################
print("-"*50)
print("Step 4 - Train the model")
print("-"*50)

model.fit(X_scaled,Y,epochs=50,verbose=0)

##########################################################
# Step 5 - Evaluate the model
##########################################################
print("-"*50)
print("Step 5 - Evaluate the model")
print("-"*50)

loss,acc=model.evaluate(X_scaled,Y,verbose=0)
print(f"Accuracy :{acc:.2f}")

##########################################################
# Step 6 - Predict new applicant
##########################################################
print("-"*50)
print("Step 6 - Predict new applicant")
print("-"*50)

new_cust=np.array([[46,1450,5,10,9]])
new_cust_scaled=scalar.transform(new_cust)

Y_pred2=model.predict(new_cust_scaled)
print(Y_pred2)
print("Prediction :", "Customer will Leave" if Y_pred2[0][0]>0.5 else "Customer will Stay")

