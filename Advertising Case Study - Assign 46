Dataset contains multiple records about the customers who invest in multiple advertisement options.  
Depends on that, the sales feature indicates the increased amount in their sales.
This dataset contains 4 features as:
TV
Radio
Television
Depends on the above three features, the Sales feature indicates the increased sale amount.

import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split 
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error,r2_score

import  matplotlib.pyplot as plt

def main():
    border="-"*50
    print(border)
    # Step 1 - Load the Data
    print("Step 1 - Load the Data")
    print(border)  
    DataPath="Advertising.csv"
    df=pd.read_csv(DataPath)
    print(df.head())
    
    #Step 2 - Clean,Prepare and Manipulate Data
    print(border)
    print("Step 2 - Clean,Prepare and Manipulate Data")
    print(border)
    print("Null values in dataset are:")
    print(df.isnull().sum())
    X=df[["TV", "radio",  "newspaper"]]
    Y=df["sales"]
    print(X.head())
    print(Y.head())
    print("Spliting the data for training and testing")
    X_train,X_test,Y_train,Y_test=train_test_split(X,Y,train_size=0.5,random_state=42)
    
    
    #Step 3 - Train the model
    print(border)
    print("Step 3 - Train the model")
    print(border)
    model=LinearRegression()
    model.fit(X_train,Y_train)
    print("Model trained successfully")
    
    #Step 4 - Test the model
    print(border)
    print("Step 4 - Test the model")
    print(border)
    
    Y_pred=model.predict(X_test)
    print("Expected answers are")
    print(Y_test[:4])
    print("Predicted answers are")
    print(Y_pred[:4])
    
    # Step 5 - Evaluate the model
    print(border)
    print("Step 5 - Evaluate the model")
    print(border)
    print("Mean and root square error:")

    mse=mean_squared_error(Y_test,Y_pred)
    rmse=np.sqrt(mse)
    r2=r2_score(Y_test,Y_pred)
    print(mse)
    print(rmse)
    print(r2)
    
    # Display Coefficient
    print(border)
    print("Display Coefficient")
    print(border)
    print("TV coefficient:",model.coef_[0])
    print("Radio",model.coef_[1])
    print("Newspaper coefficient:",model.coef_[2])
    print("Y intercept:",model.intercept_)


    plt.scatter(Y_test,Y_pred,label="Predicated vs Actual")
    plt.plot(
        [Y_test.min(),Y_pred.max()],
        [Y_pred.min(),Y_pred.max()],
        color="green",linewidth=2,label="Predciated fit line")
    plt.xlabel("Actual sales")
    plt.ylabel("Predicated sales")
    plt.title("Linear Regression : Actual vs Predicated Sales")
    plt.legend()
    plt.grid()
    plt.show()
if __name__=="__main__":
    main()
