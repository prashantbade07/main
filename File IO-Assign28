#Q1) Count Lines in a File
#Problem Statement:  
#Write a program which accepts a file name from the user and counts how many lines are present in the file.
#Input:  
#Demo.txt
#Expected Output:  
#Total number of lines in Demo.txt.

def main():
    try:
        fobj=open("Demo.txt","r") 
        print("File gets opened")
        data=fobj.readlines()
        print("Total number of lines in Demo.txt is",len(data))
        fobj.close()
        
    except FileNotFoundError as fobj:
        print("File is not present in current directory",fobj)   

if __name__=="__main__":
    main()

