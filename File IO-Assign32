1: Write a program that creates a new text file every minute.
The filename should contain the current timestamp.
Example:
File_25_07_2026_16_30_00.txt
Write the following information into the file:
Filename
Creation date
Creation time

import schedule
import datetime
import time

def fcreate():
    fname="File"+"_"+datetime.datetime.now().strftime("%d_%m_%Y %I_%M_%S")+".txt"
    fname=fname.replace(" ","_")
    fdate=datetime.datetime.now().strftime("%d_%m_%Y")
    ftime=datetime.datetime.now().strftime("%I_%M_%S")
    fread=open(fname,"w")
    fread.write("FileName:"+fname+"\n")
    fread.write("Creation Date:"+fdate+"\n")
    fread.write("Creation Time:"+ftime+"\n")
    fread.close()
    
def main():  
    schedule.every(1).minutes.do(fcreate)
    while(True):
        schedule.run_pending()
        time.sleep(30)
    
if __name__=="__main__":
    main()  

