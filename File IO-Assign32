2: Write a Python program that monitors the size of a specified file every 30 seconds.
Write the following details into:
FileSizeLog.txt
File path
File size in bytes
Date and time
Handle the situation where the file does not exist.

import schedule
import datetime
import time
import os

def fcreate():
    fname="FileSizeLog.txt"
    fdate=datetime.datetime.now().strftime("%d-%m-%Y %I_%M_%S")
    if os.path.exists(fname):
        fread=open(fname,"a")
        fpath=os.path.abspath(fname)
        fsize=os.path.getsize(fname)
        fread.write("File Path:"+fpath+"\n")
        fread.write("File Size:"+str(fsize)+"\n")
        fread.write("Date and Time:"+fdate+"\n")
        fread.write("--------------------------------------------------"+"\n")
        print(fpath)
        print(str(fsize))
        fread.close()
    else:
        file=open(fname,"a")
        file.write("File does not exist at:"+datetime.datetime.now().strftime("%d-%m-%Y %I_%M_%S")+"\n\n")
    
def main():  
    schedule.every(30).seconds.do(fcreate)
    while(True):
        schedule.run_pending()
        time.sleep(10)
    
if __name__=="__main__":
    main()  

