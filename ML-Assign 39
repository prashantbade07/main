#---------------------------------------------------------------

student_data={
    "StudyHours":[6],
    "Attendance":[85],
    "PreviousScore":[66],
    "AssignmentsCompleted":[7],
    "SleepHours":[7]
    
}
df_test=pd.DataFrame(student_data)
