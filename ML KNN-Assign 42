    print(Border)
    
    imax2=0
    name2=""
    for k in range(1,6,2):
        nearest_2=sorted_data[:k]        
        # Voting
        vote_2={}
        for d in nearest_2:
            print(d)
            Label_2=d["Label"]
            vote_2[Label_2]=vote_2.get(Label_2,0)+1
        print(vote_2)  
        # Predication
        for d in vote_2:
            if vote_2[d]>imax2:
                imax2=vote_2[d]
                name2=d
        print(f"Predicated K={k} value is",name2)
        

if __name__=="__main__":
